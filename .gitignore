# --- Secrets: never commit ---
.env
.env.*
*.env
*.pem
*.key
secrets/
*.token
token.txt

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Caches and model downloads ---
.cache/
models/
*.pth
*.onnx

# --- Generated media and rehearsal output ---
out/
output/
rehearsal-output/
# Finished posts exported for posting by hand (python -m autopilot export)
exports/
*.mp4
*.mov
*.wav
*.mp3
# Fonts and fixtures are committed explicitly; generated images are not
/media/
/samples/
# CC0 music for story reels may be committed (each needs a record in licences.json)
!assets/music/*.wav
!assets/music/*.flac
!assets/music/*.ogg
!assets/music/*.mp3

# --- OS / editors ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Owner reference images (may include personal photos) — never commit
references/
# Local previews of queued posts
pages/*/queue/*/preview/
